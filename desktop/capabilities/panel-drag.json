{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel-drag",
  "description": "Allow only the panel window to use window controls from the fixed local Whistle origin; IPC Origin headers do not contain page paths.",
  "windows": [
    "panel"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8899"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-internal-toggle-maximize"
  ],
  "local": false
}
